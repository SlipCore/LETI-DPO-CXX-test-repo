gcc -g cachegrind_example.c -o cachegrind_example
valgrind --tool=cachegrind --cache-sim=yes --branch-sim=yes ./cachegrind_example

cg_annotate cachegrind.out.<pid> --auto=yes --show=Dr,D1mr,DLmr,Dw,D1mw,DLmw

pid - выводит ранее запущенный valgrind
Смотрим Dw - общее количество операций записи, D1mw - число промахов в L1-кэше (miss write)
