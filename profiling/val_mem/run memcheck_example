// пример с valgrind memcheck
gcc -g memcheck_example.c -o memcheck_example
valgrind --leak-check=full --track-origins=yes ./memcheck_example

// пример с санитайзером
// (можно указать несоклько санитайзеров, но выполнение прервется на первой ошибке)
gcc -g -fsanitize=address memcheck_example.c -o memcheck_example
./memcheck_example
gcc -g -fsanitize=leak memcheck_example.c -o memcheck_example
./memcheck_example


